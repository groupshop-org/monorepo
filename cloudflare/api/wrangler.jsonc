{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "../../packages/backend/api/build/index.js",
  "compatibility_date": "2026-04-07",
  "env": {
    "dev": {
      "workers_dev": true,
      "preview_urls": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "DO_GROUPSHOP_AUTH_TOKEN_REFRESH",
            "class_name": "AuthTokenRefreshDo",
          },
          {
            "name": "DO_GROUPSHOP_AUTH_TOKEN_ONCE",
            "class_name": "AuthTokenOnceDo",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB_GROUPSHOP",
          "database_name": "db-dev",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "./db/migrations",
        },
      ],
    },
    "prod": {
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "prod",
        "ALLOWED_ORIGINS": "https://groupshop.org,https://admin.groupshop.org",
        "AUTH_COOKIE_SAMESITE": "strict",
        "DB_BINDING": "DB_GROUPSHOP",
        "DO_BINDING_AUTH_TOKEN_REFRESH": "DO_GROUPSHOP_AUTH_TOKEN_REFRESH",
        "DO_BINDING_AUTH_TOKEN_ONCE": "DO_GROUPSHOP_AUTH_TOKEN_ONCE",
        "OPENID_GOOGLE_REDIRECT_URI": "https://api.groupshop.org/auth/openid-access-token-hook/google",
        "URL_LANDING": "https://groupshop.org",
        "POSTMARK_FROM_EMAIL": "notifications@groupshop.org",
        "POSTMARK_MESSAGE_STREAM": "outbound",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DO_GROUPSHOP_AUTH_TOKEN_REFRESH",
            "class_name": "AuthTokenRefreshDo",
          },
          {
            "name": "DO_GROUPSHOP_AUTH_TOKEN_ONCE",
            "class_name": "AuthTokenOnceDo",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB_GROUPSHOP",
          "database_name": "db-prod",
          "database_id": "8cec726f-b2bf-4825-bc58-dd656e285c75",
          "migrations_dir": "./db/migrations",
        },
      ],
    },
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthTokenRefreshDo", "AuthTokenOnceDo"],
    },
  ],
  // Periodic batch recycling. The scheduled handler in lib.rs sweeps
  // open batches, advances any whose on-chain pool has auto-locked, and
  // opens the successor batch. Runs every minute — on-chain auto-lock
  // is the trigger, so users only see ~1 minute of latency between
  // threshold-hit and the next batch being available for deposits.
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
}
