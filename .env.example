SOLANA_RPC_URL_CLIENT_DEVNET="https://api.devnet.solana.com"  # returned to browser/Phantom; defaults to SOLANA_RPC_URL_DEVNET
SOLANA_MARKET_PROGRAM_ID_DEVNET="" # optional if .deployments/devnet/market-program.json exists
